{
    "name": "ads-solutions/webhotelier",
    "description": "WebHotelier for WordPress (dev tooling only; the plugin ships with no runtime Composer dependencies).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6"
    },
    "autoload-dev": {
        "classmap": [
            "includes/",
            "admin/",
            "public/",
            "tests/unit/"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": false
        },
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
